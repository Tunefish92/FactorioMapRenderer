# Copy to .env and adjust. The admin password goes into admin.env (see admin.env.example).

# Port the map is served on.
FMR_PORT=8080

# Where the rendered map, settings and downloads are kept on the host.
FMR_DATA_HOST_PATH=./map-data

# Highest rendered zoom level (5-10).
FMR_MAX_ZOOM=9

# Download a newer headless server from factorio.com for saves newer than the one in the image.
FMR_DOWNLOAD_HEADLESS=true

# Owner of the data folder; the app runs as this user.
PUID=1000
PGID=1000
