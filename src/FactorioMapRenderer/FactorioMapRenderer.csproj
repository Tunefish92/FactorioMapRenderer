<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>FactorioMapRenderer</RootNamespace>
    <Version>0.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" LogicalName="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- What changed in this version is shown to visitors once after an update. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Changelog.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FactorioMapRenderer.Tests" />
  </ItemGroup>

</Project>
